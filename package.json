{
  "name": "react-element-to-jsx-string",
  "version": "18.0.0",
  "description": "Turn a ReactElement into the corresponding JSX string.",
  "packageManager": "pnpm@9.15.2",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest",
    "release": "./release.sh",
    "smoke": "node tests/smoke/run.js",
    "typecheck": "tsc --noEmit"
  },
  "author": {
    "name": "Algolia, Inc.",
    "url": "https://github.com/algolia"
  },
  "license": "MIT",
  "repository": "algolia/react-element-to-jsx-string",
  "dependencies": {
    "@base2/pretty-print-object": "1.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-angular": "^19.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-is": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "conventional-changelog-cli": "2.1.1",
    "esm": "3.2.25",
    "happy-dom": "^17.1.0",
    "mversion": "2.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
